# Copier ce fichier vers backend/.env et remplir les valeurs.
# backend/.env est ignoré par git : les vraies clés ne sont jamais versionnées.

SECRET_KEY=changez-moi-cle-django-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://utilisateur:mot_de_passe@localhost:5432/ai_learning

# Chemin de l'admin Django natif — en production, changez-le pour autre
# chose que "admin/" (ex: un segment aléatoire) et restreignez-y l'accès au
# niveau réseau (IP allowlist/VPN devant le reverse-proxy).
ADMIN_URL_PATH=admin/

# Coach IA — au moins un des deux fournisseurs (DeepSeek prioritaire si les deux sont présents)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# IDE — exécution de code via l'API JDoodle (https://www.jdoodle.com, plan gratuit)
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# Connexion/inscription Google — laisser vide pour désactiver le bouton
GOOGLE_CLIENT_ID=

# Adresse qui reçoit les messages du formulaire "Nous contacter"
CONTACT_EMAIL=contact@ai-learning.local

# ============================================================
# Ce qui suit ne concerne QUE la production (Render) — inutile en dev local,
# où les valeurs par défaut dans settings.py suffisent déjà.
# ============================================================

# Domaine(s) exact(s) du backend une fois déployé, séparés par des virgules
# (ex: ai-learning-backend.onrender.com). RENDER_EXTERNAL_HOSTNAME est ajouté
# automatiquement par Render en plus de cette liste, pas besoin de le répéter.
ALLOWED_HOSTS=

# URL complète (avec https://) du frontend déployé sur Vercel — nécessaire
# pour que le backend accepte ses requêtes (CORS) et pour construire les
# liens cliquables dans les emails (réinitialisation de mot de passe...).
CORS_ALLOWED_ORIGINS=https://votre-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://votre-app.vercel.app
FRONTEND_URL=https://votre-app.vercel.app

# Stockage des fichiers uploadés (vidéos, PDF...) sur Cloudflare R2 plutôt
# que sur le disque local — obligatoire en prod sur Render (disque éphémère).
USE_S3=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=media.votre-domaine.com
