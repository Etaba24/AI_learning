# Copier ce fichier vers backend/.env et remplir les valeurs.
# backend/.env est ignoré par git : les vraies clés ne sont jamais versionnées.

SECRET_KEY=changez-moi-cle-django-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://utilisateur:mot_de_passe@localhost:5432/ai_learning

# Chemin de l'admin Django natif — en production, changez-le pour autre
# chose que "admin/" (ex: un segment aléatoire) et restreignez-y l'accès au
# niveau réseau (IP allowlist/VPN devant le reverse-proxy).
ADMIN_URL_PATH=admin/

# Coach IA — au moins un des deux fournisseurs (DeepSeek prioritaire si les deux sont présents)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# IDE — exécution de code via l'API JDoodle (https://www.jdoodle.com, plan gratuit)
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
